# Backend runtime
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Default to PostgreSQL; set DJANGO_DB_ENGINE=sqlite for local registration testing.
DJANGO_DB_ENGINE=postgresql
SQLITE_DB_PATH=db.sqlite3
MEDIA_ROOT=media
DJANGO_FILE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
PROFILE_PHOTO_MAX_BYTES=5242880
STT_DAILY_LIMIT=30
STT_MODEL_ID=Systran/faster-whisper-tiny
STT_MODEL_SIZE=tiny
STT_MODEL_DIR=
STT_MODEL_REVISION=d90ca5fe260221311c53c58e660288d3deb8d356
STT_MODEL_MANIFEST=backend/voice/model_sha256.json
STT_MODEL_REQUIRED=false
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=es
STT_CPU_THREADS=2
STT_MAX_CONCURRENT=1
AUDIO_MAX_BYTES=2097152
AUDIO_MAX_SECONDS=30
POSTGRES_DB=notara
POSTGRES_USER=notara
POSTGRES_PASSWORD=notara
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Frontend runtime
VITE_API_BASE_URL=http://localhost:8000/api/v1
