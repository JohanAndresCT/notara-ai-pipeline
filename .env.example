# Backend runtime
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Default to PostgreSQL; set DJANGO_DB_ENGINE=sqlite for local registration testing.
DJANGO_DB_ENGINE=postgresql
SQLITE_DB_PATH=db.sqlite3
POSTGRES_DB=notara
POSTGRES_USER=notara
POSTGRES_PASSWORD=notara
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend runtime
VITE_API_BASE_URL=http://localhost:8000/api
