{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:DJANGO_DB_ENGINE='sqlite'; $env:DJANGO_DEBUG='True'; $env:STT_MODEL_DIR=(Resolve-Path '.local-models/whisper-base').Path; $env:STT_MODEL_REQUIRED='true'; .\\.venv\\Scripts\\python.exe backend\\manage.py runserver 127.0.0.1:8000 --noreload"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
